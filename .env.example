# Figma Project ID (CMS Resource ID)
FIGMA_PROJECT_ID=

# Environment name (e.g., production, staging)
FIGMA_ENVIRONMENT_NAME=production

# Customer.io App API — used by admins to pull Design Studio HTML
CUSTOMERIO_APP_API_KEY=
# Optional. Defaults to https://api.customer.io (use https://api-eu.customer.io for EU)
CUSTOMERIO_APP_API_URL=
